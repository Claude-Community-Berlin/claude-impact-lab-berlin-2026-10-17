    "/api/v1/kitas/{code}": {
      "get": {
        "tags": [
          "kitas"
        ],
        "summary": "Get Kita",
        "description": "Look up a Kita by code (case-insensitive). Only one Kita exists: settings.kita_code.\n\nTODO (Dev A): return KitaInfo from settings (kita_code / kita_name / kita_city);\nraise NotFound(\"Kita code not found.\") for any other code.",
        "operationId": "get_kita_api_v1_kitas__code__get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KitaInfo"
