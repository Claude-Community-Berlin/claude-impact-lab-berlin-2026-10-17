  "components": {
    "schemas": {
      "AnnouncementIn": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "event",
              "closure",
              "deadline",
              "reminder"
            ],
            "title": "Type"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "message": {
            "type": "string",
            "maxLength": 1000,
            "title": "Message",
            "default": ""
          },
          "starts_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts On",
            "description": "Null only when recurring"
          },
          "time": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Time"
          },
          "deadline_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline On"
          },
          "bring": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Bring"
          },
          "recurring": {
            "anyOf": [
              {
                "type": "string",
                "const": "daily"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recurring"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "title"
        ],
        "title": "AnnouncementIn",
        "description": "Written by staff in German."
      },
      "AnnouncementOut": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "event",
              "closure",
              "deadline",
              "reminder"
            ],
